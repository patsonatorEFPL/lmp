# ============================================================================
# Variables Dokploy "Compose" pour stack observabilité LMP
# ============================================================================
# Copier en .env (gitignored) et renseigner avant le déploiement.
# Dans Dokploy : Project > Compose > Environment Variables.

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# ---- Prometheus Basic Auth (côté client) ----
# Ces credentials doivent matcher PROMETHEUS_BASIC_USER / PROMETHEUS_BASIC_PASS
# définis sur les backends LMP (prod et dev).
# IMPORTANT : il faut aussi écrire les passwords dans les fichiers
#   prometheus/secrets/prom-prod-pass
#   prometheus/secrets/prom-dev-pass
# (mounts read-only consommés par Prometheus via password_file).
PROMETHEUS_BASIC_USER=prometheus
# (Les vraies valeurs vont dans les fichiers secrets/, pas ici.)

# ---- Postgres exporter prod ----
# Format : postgresql://user:pass@host:5432/dbname?sslmode=disable
# Hostname = nom du conteneur Postgres prod (réseau partagé).
POSTGRES_EXPORTER_DSN_PROD=postgresql://postgres:CHANGE_ME@lmp-prod-db:5432/lmp_db?sslmode=disable

# ---- Réseau Docker partagé avec backend LMP prod ----
# Le réseau créé par Dokploy pour l'Application "lmpback".
# À récupérer via : docker network ls | grep lmp
LMP_NETWORK_NAME=dokploy-network

# Hostname du conteneur backend prod sur le réseau partagé
# (par défaut le slug Dokploy de l'app)
LMP_BACKEND_HOST=lmpback
