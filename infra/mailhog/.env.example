# ============================================================================
# Variables Dokploy "Compose" pour MailHog
# ============================================================================
# Copier en .env (gitignored) et renseigner avant deploy.

# ---- Basic Auth UI Traefik ----
# Generate via: htpasswd -nb admin <password>
# Exemple: admin:$apr1$xyz...$abc...
# Puis remplacer chaque $ par $$ pour Docker Compose:
MAILHOG_BASIC_AUTH=admin:$$apr1$$REPLACE_ME$$REPLACE_ME
