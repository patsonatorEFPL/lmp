package com.lmp.service.email;

import com.lmp.config.MailAddressConfig;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.mockito.junit.jupiter.MockitoSettings;
import org.mockito.quality.Strictness;
import org.springframework.test.util.ReflectionTestUtils;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

/**
 * Tests unitaires pour MailtrapService avec SDK officiel
 */
@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
class MailtrapServiceTest {

    @Mock
    private MailAddressConfig mailAddressConfig;

    @InjectMocks
    private MailtrapService mailtrapService;

    @BeforeEach
    void setUp() {
        // Configuration mock des adresses email
        when(mailAddressConfig.getNoreply()).thenReturn("noreply@lmp-services.ca");
        when(mailAddressConfig.getSupport()).thenReturn("support@lmp-services.ca");
        when(mailAddressConfig.getReplyToSupport()).thenReturn("support@lmp-services.ca");
        when(mailAddressConfig.getName()).thenReturn("LMP Services");
    }

    @Test
    void testServiceCreationWithValidToken() {
        // Given
        String validToken = "mt_valid_test_token_12345";
        
        // When
        MailtrapService service = new MailtrapService(validToken);
        ReflectionTestUtils.setField(service, "mailAddressConfig", mailAddressConfig);
        ReflectionTestUtils.setField(service, "apiToken", validToken);
        ReflectionTestUtils.setField(service, "accountId", "123456");
        
        // Then
        assertTrue(service.isConfigured());
        assertEquals("Mailtrap configured: true, API Token: SET, Account ID: SET", 
                    service.getConfigInfo());
    }

    @Test
    void testServiceCreationWithInvalidToken() {
        // Given
        String invalidToken = "YOUR_MAILTRAP_API_TOKEN_HERE";
        
        // When
        MailtrapService service = new MailtrapService(invalidToken);
        ReflectionTestUtils.setField(service, "mailAddressConfig", mailAddressConfig);
        ReflectionTestUtils.setField(service, "apiToken", invalidToken);
        ReflectionTestUtils.setField(service, "accountId", "YOUR_MAILTRAP_ACCOUNT_ID_HERE");
        
        // Then
        assertFalse(service.isConfigured());
        assertEquals("Mailtrap configured: false, API Token: SET, Account ID: SET", 
                    service.getConfigInfo());
    }

    @Test
    void testServiceCreationWithNullToken() {
        // Given
        String nullToken = null;
        
        // When
        MailtrapService service = new MailtrapService(nullToken);
        ReflectionTestUtils.setField(service, "mailAddressConfig", mailAddressConfig);
        
        // Then
        assertFalse(service.isConfigured());
        assertEquals("Mailtrap configured: false, API Token: NOT_SET, Account ID: NOT_SET", 
                    service.getConfigInfo());
    }

    @Test
    void testConfigurationValidation() {
        // Given - Service avec token non configuré
        MailtrapService unconfiguredService = new MailtrapService("YOUR_MAILTRAP_API_TOKEN_HERE");
        ReflectionTestUtils.setField(unconfiguredService, "mailAddressConfig", mailAddressConfig);
        ReflectionTestUtils.setField(unconfiguredService, "apiToken", "YOUR_MAILTRAP_API_TOKEN_HERE");
        ReflectionTestUtils.setField(unconfiguredService, "accountId", "YOUR_MAILTRAP_ACCOUNT_ID_HERE");
        
        // Then
        assertFalse(unconfiguredService.isConfigured());
        
        // Given - Service avec vraie configuration
        MailtrapService configuredService = new MailtrapService("mt_real_token_123");
        ReflectionTestUtils.setField(configuredService, "mailAddressConfig", mailAddressConfig);
        ReflectionTestUtils.setField(configuredService, "apiToken", "mt_real_token_123");
        ReflectionTestUtils.setField(configuredService, "accountId", "123456");
        
        // Then
        assertTrue(configuredService.isConfigured());
    }

    @Test
    void testEmailConfigurationFromMailAddressConfig() {
        // Given
        MailtrapService service = new MailtrapService("mt_valid_token");
        ReflectionTestUtils.setField(service, "mailAddressConfig", mailAddressConfig);
        
        // When & Then
        verify(mailAddressConfig, never()).getNoreply(); // Pas encore appelé
        
        // Les méthodes publiques qui utilisent mailAddressConfig ne peuvent pas être testées
        // facilement sans un client Mailtrap réel, mais nous pouvons vérifier
        // que la configuration est bien injectée
        assertNotNull(ReflectionTestUtils.getField(service, "mailAddressConfig"));
    }

    @Test
    void testGetConfigInfoFormats() {
        // Given
        MailtrapService service = new MailtrapService("mt_token_123");
        ReflectionTestUtils.setField(service, "apiToken", "mt_token_123");
        ReflectionTestUtils.setField(service, "accountId", "account_456");
        
        // When
        String configInfo = service.getConfigInfo();
        
        // Then
        assertNotNull(configInfo);
        assertTrue(configInfo.contains("Mailtrap configured:"));
        assertTrue(configInfo.contains("API Token: SET"));
        assertTrue(configInfo.contains("Account ID: SET"));
    }

    @Test
    void testIsConfiguredWithPartialConfiguration() {
        // Test avec API Token valide mais Account ID manquant
        MailtrapService serviceWithTokenOnly = new MailtrapService("mt_valid_token");
        ReflectionTestUtils.setField(serviceWithTokenOnly, "apiToken", "mt_valid_token");
        ReflectionTestUtils.setField(serviceWithTokenOnly, "accountId", null);
        
        assertTrue(serviceWithTokenOnly.isConfigured()); // Seul le token est requis
        
        // Test avec API Token et Account ID placeholder
        ReflectionTestUtils.setField(serviceWithTokenOnly, "accountId", "YOUR_MAILTRAP_ACCOUNT_ID_HERE");
        assertTrue(serviceWithTokenOnly.isConfigured()); // Seul le token est requis
    }

    @Test
    void testTestConnectionWithConfiguredService() {
        // Given
        MailtrapService service = new MailtrapService("mt_valid_token");
        
        // When
        boolean result = service.testConnection();
        
        // Then
        assertTrue(result); // Devrait retourner true si configuré
    }

    @Test
    void testTestConnectionWithUnconfiguredService() {
        // Given
        MailtrapService service = new MailtrapService(null);
        
        // When
        boolean result = service.testConnection();
        
        // Then
        assertFalse(result); // Devrait retourner false si non configuré
    }
}
