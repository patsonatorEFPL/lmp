<!DOCTYPE html>
<html lang="fr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LMP - Local Map Profil | Visibilité Locale</title>
    <meta name="description" content="Nous prenons soin de votre visibilité locale. Expertise en référencement, gestion d'avis et présence digitale.">
    
    <!-- Global Styles -->
    <div th:replace="fragments/styles :: global-styles"></div>
</head>
<body class="min-h-screen bg-white">
    <!-- Header -->
    <div th:replace="fragments/navigation :: navigation"></div>

    <main>
        <!-- Hero Section -->
        <section id="home" class="bg-gradient-to-br from-[#f7f8fa] to-white py-16 lg:py-24">
            <div class="container mx-auto px-4">
                <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
                    <!-- Hero Text -->
                    <div class="flex-1 lg:max-w-2xl">
                        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold text-dark mb-6 leading-tight">
                            Nous prenons soin de votre
                            <span class="text-primary"> visibilité locale</span>
                        </h1>
                        <p class="text-lg lg:text-xl text-secondary mb-8 leading-relaxed">
                            Nous nous engageons pour la réussite de votre entreprise sur Google et les plateformes locales. 
                            Expertise en référencement, gestion d'avis et présence digitale.
                        </p>
                        
                        <!-- Email Form -->
                        <form onsubmit="handleEmailSubmit(event)" class="flex flex-col sm:flex-row gap-4 mb-8">
                            <input
                                type="email"
                                placeholder="Votre email professionnel"
                                class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                                required
                            />
                            <button type="submit" class="bg-primary text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-all duration-200">
                                Commencer
                            </button>
                        </form>

                        <!-- Trust Indicators -->
                        <div class="flex flex-wrap items-center gap-6 text-sm text-secondary">
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                                <span>Consultation gratuite</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                                <span>Résultats garantis</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                                <span>Support dédié</span>
                            </div>
                        </div>
                    </div>

                    <!-- Hero Visual -->
                    <div class="flex-1 lg:max-w-lg">
                        <div class="relative">
                            <!-- Main Visual Container -->
                            <div class="bg-gradient-to-br from-primary to-[#4c63ff] rounded-2xl p-8 shadow-2xl">
                                <div class="text-center text-white">
                                    <div class="text-6xl mb-4">📊</div>
                                    <h3 class="text-xl font-semibold mb-2">Croissance Digitale</h3>
                                    <p class="text-blue-100">Optimisation & Performance</p>
                                </div>
                            </div>
                            
                            <!-- Floating Stats -->
                            <div class="absolute -top-4 -right-4 bg-yellow text-dark px-4 py-2 rounded-lg font-bold shadow-lg floating-element">
                                245% ROI
                            </div>
                            <div class="absolute -bottom-4 -left-4 bg-white px-4 py-2 rounded-lg font-bold shadow-lg text-primary floating-element floating-element-delayed">
                                130K+ Clients
                            </div>
                        </div>
