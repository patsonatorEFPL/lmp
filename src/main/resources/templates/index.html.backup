                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <button onclick="openBookingModal()" class="bg-yellow text-dark px-8 py-4 rounded-lg font-semibold hover:bg-yellow/90 transition-all duration-200">
                        Prendre un rendez-vous
                    </button>
                    <a href="mailto:lmp.assistance@gmail.com" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-primary transition-all duration-200">
                        Nous contacter
