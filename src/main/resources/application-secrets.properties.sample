# ========================================
# TEMPLATE — SECRETS D'APPLICATION
# ========================================
# Copiez ce fichier vers application-secrets.properties et remplissez les valeurs.
# Le fichier application-secrets.properties est dans .gitignore et ne sera jamais committé.

# -----------------
# BASE DE DONNÉES
# -----------------
DB_USERNAME=lmp_dev
DB_PASSWORD=votre_mot_de_passe_local

# -----------------
# STRIPE (TEST KEYS)
# -----------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------
# SMTP (Mailtrap ou Stalwart)
# -----------------
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=api
SMTP_PASSWORD=votre_token_mailtrap
MAILTRAP_API_TOKEN=votre_token_mailtrap
MAILTRAP_ACCOUNT_ID=votre_account_id

# -----------------
# OAUTH2 GOOGLE
# -----------------
spring.security.oauth2.client.registration.google.client-id=votre_google_client_id
spring.security.oauth2.client.registration.google.client-secret=votre_google_client_secret

# -----------------
# OAUTH2 MICROSOFT (Azure AD)
# -----------------
spring.security.oauth2.client.registration.microsoft.client-id=votre_microsoft_client_id
spring.security.oauth2.client.registration.microsoft.client-secret=votre_microsoft_client_secret
