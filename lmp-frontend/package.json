{
  "name": "lmp-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "codegen": "npx ng-openapi-gen --config ng-openapi-gen.json",
    "fetch-spec": "node -e \"const h=require('http');const f=require('fs');h.get('http://localhost:8080/v3/api-docs',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{f.writeFileSync('openapi.json',d);console.log('openapi.json mis à jour');});}).on('error',e=>{console.error('Backend non disponible:',e.message);process.exit(1);});\"",
    "update-api": "npm run fetch-spec && npm run codegen",
    "prebuild": "npm run codegen",
    "prestart": "npm run codegen"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^21.2.1",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.1",
    "@angular/platform-server": "^21.2.5",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.3",
    "@spartan-ng/brain": "^0.0.1-alpha.648",
    "@stripe/stripe-js": "^9.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "lucide-angular": "^0.577.0",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@spartan-ng/cli": "^0.0.1-alpha.648",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "handlebars": "^4.7.9",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.0.5",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
