# ========================================
# .dockerignore pour Railway.com
# Application Spring Boot LMP
# ========================================

# Fichiers et dossiers à exclure du contexte Docker

# Documentation et guides
*.md
docs/
*.txt

# Fichiers de développement
.gitignore
.gitattributes

# IDE et éditeurs
.vscode/
.idea/
*.iml
*.ipr
*.iws
.eclipse/
.metadata/
.settings/
.project
.classpath

# Logs
*.log
logs/
hs_err_*.log
replay_*.log

# Fichiers temporaires
*.tmp
*.temp
*.swp
*.swo
*~

# Dossiers de build local (seront reconstruits dans Docker)
target/
build/
out/
.mvn/wrapper/maven-wrapper.jar

# Cache Maven local
.m2/

# Fichiers de configuration locale
application-local.properties
application-dev.properties

# Fichiers de test
src/test/
**/test-results/
**/coverage/

# Node.js (si utilisé pour le frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables d'environnement locales
.env
.env.local
.env.development
.env.test

# Fichiers de sauvegarde
*.bak
*.backup

# OS spécifiques
.DS_Store
Thumbs.db
desktop.ini

# Scripts de développement
scripts/
*.py
*.sh

# Invoices générées localement
invoices/

# Autres fichiers non nécessaires en production
cookies.txt
debug-*.html
debug-*.js
*.sql