# Cloudflare tunnel local-dev config — copy to tunnel.env and fill in.
# tunnel.env is gitignored (matches *.env in .gitignore).

# === Cloudflare ===
# API token scope = "Zone.DNS:Edit" sur "All zones from an account".
# (Profile → API Tokens → Create Token → "Edit zone DNS" → Zone Resources :
#  Include → All zones from an account → <ton account>)
# Permet d'ajouter lmpeo.com plus tard sans recréer le token.
CF_API_TOKEN=

# Tunnel UUID (from `cloudflared tunnel create lmp-dev-laptop`)
TUNNEL_ID=

# Path to tunnel credentials JSON (auto-created by `cloudflared tunnel create`)
TUNNEL_CREDENTIALS=C:\Users\MrCode\.cloudflared\<UUID>.json

# === Hostnames à exposer via tunnel ===
# Liste séparée par virgules. Ajoute/enlève au besoin.
# La zone Cloudflare est résolue automatiquement par suffixe (lmp-services.ca, lmpeo.com, etc.)
# - dev.lmp-services.ca + auth.dev.lmp-services.ca aujourd'hui
# - dev.lmpeo.com + auth.dev.lmpeo.com plus tard (ajout = juste 2 entrées en plus)
TUNNEL_HOSTS=dev.lmp-services.ca,auth-dev.lmp-services.ca

# IP cible quand le tunnel est OFF (restore A record). Tous les hosts pointent ici.
DOKPLOY_IP=140.238.216.231

# === SSH tunnel pour Postgres staging ===
DOKPLOY_SSH_HOST=140.238.216.231
DOKPLOY_SSH_USER=ubuntu

# Local port (Spring : jdbc:postgresql://localhost:LOCAL_PG_PORT/lmp_test_db)
LOCAL_PG_PORT=5433

# Endpoint Postgres atteignable depuis l'host Dokploy
REMOTE_PG_HOST=localhost
REMOTE_PG_PORT=5432
