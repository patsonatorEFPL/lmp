{
  "info": {
    "name": "LMP Stripe Checkout API",
    "description": "Collection complète pour tester l'API de paiement Stripe Checkout",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "api_path",
      "value": "/api",
      "type": "string"
    },
    {
      "key": "test_order_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "checkout_session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "your_jwt_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Payment Operations",
      "description": "Endpoints pour les opérations de paiement",
      "item": [
        {
          "name": "Calculate Processing Fees",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains fees calculation\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('fees');",
                  "    pm.expect(jsonData).to.have.property('totalAmount');",
                  "    pm.expect(jsonData.provider).to.eql('stripe');",
                  "});",
                  "",
                  "pm.test(\"Fees are calculated correctly\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const amount = parseFloat(pm.request.url.query.get('amount'));",
                  "    const expectedFees = (amount * 0.029) + 0.30;",
                  "    pm.expect(jsonData.fees).to.be.closeTo(expectedFees, 0.01);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_path}}/payments/fees?amount=100.00&currency=CAD",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "payments", "fees"],
              "query": [
                {
                  "key": "amount",
                  "value": "100.00",
                  "description": "Montant du paiement"
                },
                {
                  "key": "currency",
                  "value": "CAD",
                  "description": "Devise (CAD, USD, EUR, etc.)"
                },
                {
                  "key": "provider",
                  "value": "stripe",
                  "description": "Fournisseur de paiement (optionnel)",
                  "disabled": true
                }
              ]
            },
            "description": "Calcule les frais de traitement pour un montant donné"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}{{api_path}}/payments/fees?amount=100.00&currency=CAD",
                  "host": ["{{base_url}}"],
                  "path": ["{{api_path}}", "payments", "fees"],
                  "query": [
                    {"key": "amount", "value": "100.00"},
                    {"key": "currency", "value": "CAD"}
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {"key": "Content-Type", "value": "application/json"}
              ],
              "cookie": [],
              "body": "{\n  \"amount\": 100.00,\n  \"currency\": \"CAD\",\n  \"provider\": \"stripe\",\n  \"paymentMethod\": \"checkout_session\",\n  \"fees\": 3.20,\n  \"totalAmount\": 103.20,\n  \"note\": \"Frais calculés pour Stripe Checkout uniquement\"\n}"
            }
          ]
        },
        {
          "name": "Process Payment (Create Checkout Session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Payment session created successfully\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData).to.have.property('transactionId');",
                  "    pm.expect(jsonData).to.have.property('redirectUrl');",
                  "    pm.expect(jsonData.requiresRedirect).to.be.true;",
                  "    ",
                  "    // Sauvegarder l'ID de session pour les tests suivants",
                  "    pm.collectionVariables.set('checkout_session_id', jsonData.transactionId);",
                  "});",
                  "",
                  "pm.test(\"Redirect URL is valid Stripe Checkout URL\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.redirectUrl).to.include('checkout.stripe.com');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150.00,\n  \"currency\": \"CAD\",\n  \"paymentProvider\": \"stripe\",\n  \"paymentMethod\": \"checkout_session\",\n  \"metadata\": {\n    \"customer_note\": \"Test payment via Postman\",\n    \"source\": \"postman_test\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/payments/process/{{test_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "payments", "process", "{{test_order_id}}"],
              "variable": [
                {
                  "key": "test_order_id",
                  "value": "{{test_order_id}}"
                }
              ]
            },
            "description": "Crée une session Stripe Checkout pour traiter un paiement"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 150.00,\n  \"currency\": \"CAD\",\n  \"paymentProvider\": \"stripe\",\n  \"paymentMethod\": \"checkout_session\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}{{api_path}}/payments/process/1",
                  "host": ["{{base_url}}"],
                  "path": ["{{api_path}}", "payments", "process", "1"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {"key": "Content-Type", "value": "application/json"}
              ],
              "body": "{\n  \"success\": true,\n  \"transactionId\": \"cs_test_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0\",\n  \"paymentId\": \"cs_test_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0\",\n  \"amount\": 150.00,\n  \"currency\": \"CAD\",\n  \"status\": \"PENDING\",\n  \"paymentMethod\": \"checkout_session\",\n  \"paymentProvider\": \"stripe-checkout\",\n  \"processingFees\": 4.65,\n  \"message\": \"Session Stripe Checkout créée avec succès\",\n  \"redirectUrl\": \"https://checkout.stripe.com/c/pay/cs_test_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0\",\n  \"requiresRedirect\": true\n}"
            }
          ]
        },
        {
          "name": "Check Transaction Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Status response is valid\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData).to.have.property('checkedAt');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_path}}/payments/transaction/{{checkout_session_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "payments", "transaction", "{{checkout_session_id}}", "status"]
            },
            "description": "Vérifie le statut d'une transaction de paiement"
          }
        },
        {
          "name": "Get Transaction Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Transaction details are valid\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('amount');",
                  "    pm.expect(jsonData).to.have.property('currency');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_path}}/payments/transaction/1",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "payments", "transaction", "1"]
            },
            "description": "Récupère les détails complets d'une transaction"
          }
        },
        {
          "name": "Get Order Transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_path}}/payments/order/{{test_order_id}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "payments", "order", "{{test_order_id}}", "transactions"]
            },
            "description": "Récupère toutes les transactions associées à une commande"
          }
        },
        {
          "name": "Get Supported Providers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Only Stripe Checkout is supported\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.providers).to.have.lengthOf(1);",
                  "    pm.expect(jsonData.providers[0]).to.eql('stripe-checkout');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_path}}/payments/providers",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "payments", "providers"]
            },
            "description": "Liste tous les fournisseurs de paiement supportés"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}{{api_path}}/payments/providers",
                  "host": ["{{base_url}}"],
                  "path": ["{{api_path}}", "payments", "providers"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {"key": "Content-Type", "value": "application/json"}
              ],
              "body": "{\n  \"providers\": [\"stripe-checkout\"],\n  \"count\": 1\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Webhook Operations",
      "description": "Endpoints pour les webhooks et notifications",
      "item": [
        {
          "name": "Stripe Webhook - Checkout Session Completed",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Webhook processed successfully\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.received).to.be.true;",
                  "    pm.expect(jsonData).to.have.property('eventId');",
                  "    pm.expect(jsonData).to.have.property('eventType');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Stripe-Signature",
                "value": "t=1629794400,v1=test_signature_for_development"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_webhook_12345\",\n  \"object\": \"event\",\n  \"api_version\": \"2023-10-16\",\n  \"created\": 1629794400,\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0\",\n      \"object\": \"checkout.session\",\n      \"amount_total\": 15000,\n      \"currency\": \"cad\",\n      \"customer_email\": \"test@example.com\",\n      \"payment_status\": \"paid\",\n      \"payment_intent\": \"pi_test_12345\",\n      \"metadata\": {\n        \"order_id\": \"1\"\n      }\n    }\n  },\n  \"livemode\": false,\n  \"pending_webhooks\": 1,\n  \"request\": {\n    \"id\": \"req_test_12345\",\n    \"idempotency_key\": null\n  },\n  \"type\": \"checkout.session.completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_path}}/webhooks/stripe",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "webhooks", "stripe"]
            },
            "description": "Simule un webhook Stripe de session de checkout complétée"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"},
                  {"key": "Stripe-Signature", "value": "t=1629794400,v1=test_signature"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"object\": \"event\",\n  \"type\": \"checkout.session.completed\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}{{api_path}}/webhooks/stripe",
                  "host": ["{{base_url}}"],
                  "path": ["{{api_path}}", "webhooks", "stripe"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {"key": "Content-Type", "value": "application/json"}
              ],
              "body": "{\n  \"received\": true,\n  \"eventId\": \"evt_test_webhook\",\n  \"eventType\": \"checkout.session.completed\",\n  \"processed\": true,\n  \"processedAt\": \"2025-08-18T13:30:00\"\n}"
            }
          ]
        },
        {
          "name": "Webhook Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Health check successful\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_path}}/webhooks/health",
              "host": ["{{base_url}}"],
              "path": ["{{api_path}}", "webhooks", "health"]
            },
            "description": "Vérifie la santé du système de webhooks"
          }
        }
      ]
    },
